<?xml version="1.0" encoding="utf-8"?>
<!-- 布局选择浮窗背景：30% 不透明度 bg_card #132F4C（#4C 前缀 ≈ 30%），
     圆角比卡片更大（16dp），符合"浮窗"的轻盈感 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#4C132F4C" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#4C1A3A5C" />
</shape>