<?xml version="1.0" encoding="utf-8"?>
<!-- 多画面单格视图：视频 TextureView + 通道名 overlay + 错误/缓冲 overlay -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true">

    <!-- 内层 tile_root 只做内容容器，不设背景、不拿焦点，避免"外层挂监听/内层拿焦点"焦点分裂。
         无 margin：视频填满整格，不缩小画面。
         焦点白边改由外层 ChannelTileView 的 foreground 承担（setFocused → channel_tile_focused_fg）：
         foreground 叠在内容之上、不占布局空间，白边在格子边缘形成，视频原尺寸透出。 -->

    <TextureView
        android:id="@+id/tile_texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tile_channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="@string/multi_hint" />

    <TextView
        android:id="@+id/tile_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />

</FrameLayout>