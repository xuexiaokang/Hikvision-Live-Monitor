<?xml version="1.0" encoding="utf-8"?>
<!-- 多画面宫格页：宫格容器 + 顶部提示条 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 宫格容器：android.widget.GridLayout（API 21+，无需额外依赖），动态添加 ChannelTileView -->
    <android.widget.GridLayout
        android:id="@+id/grid_multi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="2"
        android:rowCount="2"
        android:orientation="horizontal"
        android:horizontalSpacing="1dp"
        android:verticalSpacing="1dp" />

    <!-- 顶部提示条（遥控器按键说明 / 触屏手势说明） -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#66000000"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- ===== 自动生成缩略图进度条（列表页"刷新缩略图"进入的预热模式才显示）=====
         作用：让用户看到 3/9 的进度，避免以为卡死而手动中断（15s 超时/全部完成后自动回列表）。
         ★ 关键：它是窗口内的覆盖层，会被 PixelCopy(Window) 截进缩略图。因此 MultiViewActivity
           会把它注册到 ThumbnailCapture.addHideOnCapture()，每次截帧瞬间自动隐藏、截完恢复，
           保证进度条看得见但不会被截进图里。 -->
    <LinearLayout
        android:id="@+id/layout_capture_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pb_capture"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="8dp"
            android:max="9"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_capture_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="正在生成缩略图… 0/9"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 全屏容器：宫格层之上、翻页栏之下。双击某个宫格后，把该格的 ChannelTileView
         临时移到此处铺满（引擎不停/不重启，只靠 onSizeChanged 自动重新铺满）；再次双击返回宫格。 -->
    <FrameLayout
        android:id="@+id/fullscreen_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- 底部页码指示（轻量、不可点击）：滑动翻页为主交互，此条仅提示当前页/总页数，
         不拦截触摸（clickable=false，事件穿透到底下的宫格）；仅一页或通道总数未知时隐藏。 -->
    <TextView
        android:id="@+id/tv_page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="#66000000"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:clickable="false"
        android:focusable="false"
        android:text="‹ 1 / 1 ›"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>