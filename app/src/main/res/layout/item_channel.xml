<?xml version="1.0" encoding="utf-8"?>
<!-- 通道卡片：圆角边框 + 黑边缩略图，缩略图填满FrameLayout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/channel_card_normal"
    android:layout_margin="4dp"
    android:focusable="true"
    android:clickable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#000000">

        <!-- 真 TextureView：libVLC RTSP 抓帧渲染到这里 -->
        <TextureView
            android:id="@+id/tv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 缩略图占位/缓存：centerCrop 填满容器 -->
        <ImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/thumbnail_placeholder"
            android:visibility="gone"
            android:contentDescription="通道预览" />

        <!-- 通道名标签 -->
        <TextView
            android:id="@+id/tv_channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#80000000"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </FrameLayout>

</LinearLayout>
