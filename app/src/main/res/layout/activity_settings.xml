<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1929"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_nvr_host"
            android:textColor="#8FAAC4"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_host"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/channel_card_selector"
            android:hint="192.168.1.23"
            android:inputType="text"
            android:paddingStart="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666680"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            android:nextFocusDown="@id/et_port" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_rtsp_port"
            android:textColor="#8FAAC4"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_port"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/channel_card_selector"
            android:hint="554"
            android:inputType="number"
            android:paddingStart="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666680"
            android:textSize="18sp"
            android:layout_marginBottom="4dp"
            android:nextFocusDown="@id/et_http_port"
            android:nextFocusUp="@id/et_host" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_rtsp_port_hint"
            android:textColor="#666680"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_http_port"
            android:textColor="#8FAAC4"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_http_port"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/channel_card_selector"
            android:hint="80"
            android:inputType="number"
            android:paddingStart="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666680"
            android:textSize="18sp"
            android:layout_marginBottom="4dp"
            android:nextFocusDown="@id/cb_http_port_follow"
            android:nextFocusUp="@id/et_port" />

        <CheckBox
            android:id="@+id/cb_http_port_follow"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="@string/settings_http_port_follow"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingStart="8dp"
            android:buttonTint="#0D47A1"
            android:layout_marginBottom="16dp"
            android:nextFocusDown="@id/et_username"
            android:nextFocusUp="@id/et_http_port" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_username"
            android:textColor="#8FAAC4"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/channel_card_selector"
            android:hint="admin"
            android:inputType="text"
            android:paddingStart="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666680"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            android:nextFocusDown="@id/et_password"
            android:nextFocusUp="@id/cb_http_port_follow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_password"
            android:textColor="#8FAAC4"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/channel_card_selector"
            android:hint="password"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666680"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"
            android:nextFocusDown="@id/cb_sub_stream"
            android:nextFocusUp="@id/et_username" />

        <CheckBox
            android:id="@+id/cb_sub_stream"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="@string/settings_use_sub_stream"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingStart="8dp"
            android:buttonTint="#0D47A1"
            android:layout_marginBottom="24dp"
            android:nextFocusDown="@id/rb_decode_hard"
            android:nextFocusUp="@id/et_password" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_decode_mode"
            android:textColor="#8FAAC4"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rg_decode_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <RadioButton
                android:id="@+id/rb_decode_hard"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="@string/settings_decode_mode_hard"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/channel_card_normal"
                android:buttonTint="@color/radio_button_tint"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="8dp"
                android:nextFocusRight="@id/rb_decode_soft"
                android:nextFocusUp="@id/cb_sub_stream"
                android:nextFocusDown="@id/btn_test" />

            <RadioButton
                android:id="@+id/rb_decode_soft"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="@string/settings_decode_mode_soft"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/channel_card_normal"
                android:buttonTint="@color/radio_button_tint"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:nextFocusLeft="@id/rb_decode_hard"
                android:nextFocusRight="@id/rb_decode_auto"
                android:nextFocusUp="@id/cb_sub_stream"
                android:nextFocusDown="@id/btn_save" />

            <RadioButton
                android:id="@+id/rb_decode_auto"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="@string/settings_decode_mode_auto"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="@drawable/channel_card_normal"
                android:buttonTint="@color/radio_button_tint"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="8dp"
                android:nextFocusLeft="@id/rb_decode_soft"
                android:nextFocusUp="@id/cb_sub_stream"
                android:nextFocusDown="@id/btn_cancel" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_decode_mode_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_decode_mode_desc_soft"
            android:textColor="#666680"
            android:textSize="13sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_decode_mode_help"
            android:textColor="#666680"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- 必须写全限定名 android.widget.Button：本 App 主题是
                 Theme.MaterialComponents.NoActionBar，裸 <Button> 会被 inflate 成
                 MaterialButton，它自行接管 background，导致 XML 的 android:background
                 与 Java 的 setBackgroundResource() 双双失效（表现为常态是 Material 蓝
                 #0D47A1、聚焦无白环）。改用平台 Button 后二者恢复正常。
                 elevation / stateListAnimator 归零：平台 Widget.Material.Button 自带
                 1dp 抬升与按压动画，会让按钮在全站扁平卡片风格里显得"浮起来"。 -->
            <android.widget.Button
                android:id="@+id/btn_test"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="测试连接"
                android:textSize="18sp"
                android:background="@drawable/channel_card_normal"
                android:textColor="#FFFFFF"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginEnd="12dp"
                android:nextFocusRight="@id/btn_save"
                android:nextFocusUp="@id/rb_decode_soft" />

            <android.widget.Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="@string/save"
                android:textSize="18sp"
                android:background="@drawable/channel_card_normal"
                android:textColor="#FFFFFF"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:nextFocusLeft="@id/btn_test"
                android:nextFocusRight="@id/btn_cancel"
                android:nextFocusUp="@id/rb_decode_hard" />

            <android.widget.Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:text="@string/cancel"
                android:textSize="18sp"
                android:background="@drawable/channel_card_normal"
                android:textColor="#CCFFFFFF"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginStart="12dp"
                android:nextFocusLeft="@id/btn_save"
                android:nextFocusUp="@id/rb_decode_auto" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_help"
            android:textColor="#666680"
            android:textSize="14sp"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="4dp" />

        <!-- 作者署名（卡片底部） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_author_xxkwz"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_author_ztfans"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_author_github"
                android:textColor="@color/text_hint"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
